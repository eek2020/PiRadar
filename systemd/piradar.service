[Unit]
Description=PiRadar aircraft display service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piradar
Group=piradar
Environment=PIRADAR_CONFIG=/etc/piradar/piradar.json
Environment=PIRADAR_FRONTEND_DIR=/opt/piradar/frontend
ExecStart=/opt/piradar/.venv/bin/piradar
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
